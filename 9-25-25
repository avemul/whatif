def fetch_yf_series(ticker: str, name: str, start, end):
    try:
        s = yf.download(ticker, start=start, end=end, auto_adjust=True)["Close"].rename(name)
        return s.dropna()
    except Exception as e:
        print(f"[WARN] yfinance failed for {name} ({ticker}): {e}")
        return pd.Series(dtype=float, name=name)


def fetch_fred_series(series_id: str, name: str, start, end):
    if not _HAS_FRED:
        print("[INFO] pandas_datareader not available; skipping FRED")
        return pd.Series(dtype=float, name=name)
    try:
        s = pdr.DataReader(series_id, "fred", start, end).squeeze().rename(name)
        return s.dropna()
    except Exception as e:
        print(f"[WARN] FRED failed for {name} ({series_id}): {e}")
        return pd.Series(dtype=float, name=name)


def fetch_google_trends(keywords, start, end, geo="US"):
    if not _HAS_TRENDS:
        print("[INFO] pytrends not available; skipping Google Trends")
        return pd.DataFrame()
    try:
        tr = TrendReq(hl="en-US", tz=360)
        tr.build_payload(keywords, timeframe=f"{start.strftime('%Y-%m-%d')} {end.strftime('%Y-%m-%d')}", geo=geo)
        df = tr.interest_over_time()
        if "isPartial" in df.columns:
            df = df.drop(columns=["isPartial"])
        return df
    except Exception as e:
        print(f"[WARN] Google Trends failed: {e}")
        return pd.DataFrame()


def fetch_rss_headlines(feeds):
    if not _HAS_FEEDPARSER:
        print("[INFO] feedparser not available; skipping RSS scraping")
        return pd.DataFrame(columns=["published", "source", "headline"])    
    rows = []
    for url in feeds:
        try:
            parsed = feedparser.parse(url)
            for entry in parsed.entries:
                published = None
                if hasattr(entry, "published_parsed") and entry.published_parsed:
                    published = datetime(*entry.published_parsed[:6])
                elif hasattr(entry, "updated_parsed") and entry.updated_parsed:
                    published = datetime(*entry.updated_parsed[:6])
                headline = entry.title if hasattr(entry, "title") else ""
                rows.append({
                    "published": published,
                    "source": re.sub(r"https?://(www\.)?", "", parsed.href) if hasattr(parsed, "href") else "rss",
                    "headline": headline,
                })
        except Exception as e:
            print(f"[WARN] RSS failed for {url}: {e}")
    df = pd.DataFrame(rows).dropna(subset=["published"]) if rows else pd.DataFrame(columns=["published", "source", "headline"]) 
    return df


