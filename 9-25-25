def _apply_pct_change_to_feature_row(row: pd.Series, feature_prefix: str, pct_change: float):
    """Adjust the most recent lag and momentum features for a given driver.
       feature_prefix is the base column name (e.g., 'oil').
       We modify columns like 'oil_lag_1' and derived momentum if present.
    """
    new_row = row.copy()
    col = f"{feature_prefix}_lag_1"
    if col in new_row.index and pd.notna(new_row[col]):
        new_row[col] = new_row[col] * (1 + pct_change)
    mom = f"{feature_prefix}_mom_5"
    if mom in new_row.index and pd.notna(new_row[mom]):
        new_row[mom] = new_row[mom] + pct_change
    return new_row


def forecast_next_day(models: dict, scalers: dict, X_all: pd.DataFrame,
                      adjustments: dict = None) -> pd.Series:
    """One‑step ahead forecast for each stock with optional driver adjustments.
       adjustments: { 'oil': +0.08, 'vix': -0.05, ... } percent changes
    """
    last_row = X_all.iloc[-1]
    if adjustments:
        for driver_name, pct in adjustments.items():
            last_row = _apply_pct_change_to_feature_row(last_row, driver_name, pct)
    preds = {}
    for stock in stocks:
        scaler = scalers[stock]
        model = models[stock]
        Xs = scaler.transform(last_row.to_frame().T)
        preds[stock] = float(model.predict(Xs)[0])
    return pd.Series(preds)

def recursive_forecast(models, scalers, X_all, days=5, adjustments=None):
    """Generate naive multi‑day forecasts by reusing the same last feature row
       (with adjustments applied each step). This is a rough approximation since
       we don't evolve the full feature set forward realistically.
    """
    last_row = X_all.iloc[-1].copy()
    path = []
    for d in range(days):
        # apply adjustments each step
        if adjustments:
            for driver_name, pct in adjustments.items():
                last_row = _apply_pct_change_to_feature_row(last_row, driver_name, pct)
        step_preds = {}
        for stock in stocks:
            scaler = scalers[stock]
            model = models[stock]
            Xs = scaler.transform(last_row.to_frame().T)
            step_preds[stock] = float(model.predict(Xs)[0])
        path.append(step_preds)
    return pd.DataFrame(path, index=pd.RangeIndex(1, days+1, name="T+day"))

def plot_forecasts(actual_series: pd.Series, preds: pd.Series, title: str = "Next‑Day Forecast"):
    plt.figure()
    actual_series.tail(60).plot(label="Actual")
    preds.plot(style='o', label="Forecast")
    plt.legend()
    plt.title(title)
    plt.xlabel("Date / Step")
    plt.ylabel("Price")
    plt.show()
