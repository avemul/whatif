def create_lagged_features(df, cols, window):
    features = pd.DataFrame(index=df.index)
    for col in cols:
        if col not in df.columns:
            continue
        for lag in range(1, window + 1):
            features[f"{col}_lag_{lag}"] = df[col].shift(lag)
        features[f"{col}_roll_mean_5"] = df[col].rolling(5).mean()
        features[f"{col}_roll_std_5"] = df[col].rolling(5).std()
        features[f"{col}_mom_5"] = df[col].pct_change(5)
    return features.dropna()

