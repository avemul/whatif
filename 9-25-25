def clean_text(s: str) -> str:
    s = s.lower()
    s = re.sub(r"https?://\S+", " ", s)
    s = re.sub(r"[^a-z0-9\s]", " ", s)
    tokens = [t for t in s.split() if t not in _stopwords and len(t) > 2]
    return " ".join(tokens)


def score_vader(texts: list) -> np.ndarray:
    if not _sia:
        return np.array([np.nan] * len(texts))
    scores = []
    for t in texts:
        try:
            scores.append(_sia.polarity_scores(t)["compound"])
        except Exception:
            scores.append(np.nan)
    return np.array(scores)


def score_finbert(texts: list) -> np.ndarray:
    if not _HAS_FINBERT:
        return np.array([np.nan] * len(texts))
    scores = []
    for t in texts:
        try:
            inputs = _finbert_tokenizer(t, return_tensors="pt", truncation=True, max_length=128)
            with torch.no_grad():
                logits = _finbert_model(**inputs).logits
            probs = torch.softmax(logits, dim=1).numpy()[0]
            # FinBERT labels: [0]=negative, [1]=neutral, [2]=positive
            score = probs[2] - probs[0]  # positive minus negative
            scores.append(float(score))
        except Exception:
            scores.append(np.nan)
    return np.array(scores)


def embed_texts(texts: list) -> np.ndarray:
    if not _HAS_EMBED or _embedder is None or not texts:
        return np.empty((0, 0))
    try:
        return _embedder.encode(texts, show_progress_bar=False)
    except Exception:
        return np.empty((0, 0))


def aggregate_sentiment(df_text: pd.DataFrame, freq: str = 'D') -> pd.DataFrame:
    """Input columns: ['published', 'headline', 'source']
       Returns time-indexed daily aggregates of VADER & FinBERT means and counts.
    """
    if df_text.empty:
        return pd.DataFrame()
    df = df_text.copy()
    df["clean"] = df["headline"].astype(str).apply(clean_text)
    df["vader"] = score_vader(df["clean"].tolist())
    df["finbert"] = score_finbert(df["clean"].tolist())
    df["date"] = pd.to_datetime(df["published"]).dt.tz_localize(None).dt.floor(freq)
    agg = df.groupby("date").agg(
        news_count=("headline", "count"),
        vader_mean=("vader", "mean"),
        finbert_mean=("finbert", "mean"),
    )
    return agg


